# Vorlage für Zugänge. Kopieren nach .env.local (nie einchecken) und nur ausfüllen, was ihr habt.
# Ohne Schlüssel laufen Produkt und Tests im Mock. Anleitung: docs/zugaenge.md

# Welches Modell das Produkt nutzt: anthropic | openai | azure | gemini | mock (leer = erster Anbieter mit Schlüssel)
# Default for the product and demo (#147): LLM_PROVIDER=anthropic plus ANTHROPIC_API_KEY (see "Anthropic" below).
# Gemini also works: LLM_PROVIDER=gemini plus GEMINI_API_KEY.
LLM_PROVIDER=
# Empty = provider default (anthropic: claude-sonnet-5-5, gemini: gemini-2.5-flash)
LLM_MODEL=
# Optional, seconds: per model call (default 60), per item-review batch (default 90, #167), for the whole
# BoQ model review (default 600, #167) and for the AI evaluation call (default 90, #167).
# A failed batch keeps the other batches' findings and is named in kennzahlen.modell_reason; only when no
# batch answers does the report fall back to the offline mock.
LLM_TIMEOUT=
LLM_BATCH_TIMEOUT=
LLM_REVIEW_TIMEOUT=
LLM_EVALUATION_TIMEOUT=
# Optional, seconds (#165): limit of one background analysis job (default 2400), separate from request
# timeouts, and how long a finished job's result stays available (default 3600)
ANALYSE_JOB_TIMEOUT=
ANALYSE_JOB_AUFBEWAHRUNG=
# Optional: items per model call (default 20) and parallel calls (default 3)
LLM_BATCH_SIZE=
LLM_PARALLEL=
# Optional: Claude effort for the item review (low|medium|high|xhigh|max; default low = fast)
LLM_REVIEW_EFFORT=
# Optional, norm research N5 (#166): off with NORM_KI_RECHERCHE=off; whole research in seconds (default 360),
# web searches per round (default 8) and research rounds = trades (default 10). Claude uses its web search tool.
NORM_KI_RECHERCHE=
NORM_KI_TIMEOUT=
NORM_KI_MAX_SEARCHES=
NORM_KI_RUNDEN=
# Optional, deep research in every AI step (#169): Claude web-searches conspicuous findings, price outliers and
# Reports 2/3 problems, grouped by trade. Off with DEEP_RESEARCH=off. Per analysis: research calls (default 24),
# web searches in total (default 192), searches per call (default 8), items per group (default 12), seconds (420).
DEEP_RESEARCH=
DEEP_RESEARCH_MAX_CALLS=
DEEP_RESEARCH_BUDGET=
DEEP_RESEARCH_MAX_USES=
DEEP_RESEARCH_MAX_ITEMS=
DEEP_RESEARCH_TIMEOUT=
DEEP_RESEARCH_PARALLEL=

# Anthropic (Claude): create a key in the Claude Console, https://platform.claude.com (API keys)
# Enter the real key only in .env.local (never in .env.example, commits, issues or the board).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# Optional: effort for other Claude calls (low|medium|high|xhigh|max; empty = model default)
ANTHROPIC_EFFORT=

# OpenAI oder ein OpenAI-kompatibler Endpunkt (z. B. ein Proxy der Veranstalter)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Google Gemini (alternative): free key from Google AI Studio, https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: 0 turns "thinking" off on Flash models (faster, fewer tokens); empty = model default
GEMINI_THINKING_BUDGET=

# Erlaubte Herkünfte der Oberfläche für das Backend, kommagetrennt (lokal reicht der Standard)
WEB_ORIGINS=

# Optional: separates Modell für Langtext-Prüfungen (sonst LLM_MODEL)
OPENAI_MODEL=

# Optional (#156): the Claude API key can also be entered in the UI (header chip). It stays in memory,
# or in .env.local when "also save" is ticked. Set LLM_KEY_UI=off on a backend that others can reach.
LLM_KEY_UI=
