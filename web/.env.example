# Copy this file to web/.env.local and fill in your own values.
# web/.env.local and the repository-root .env.local are gitignored.
# You can also put the same names in the root .env.local (see the root .env.example).
# web/next.config.mjs loads allow-listed names from those files when they are not
# already set in the environment. Do not commit real secrets.

# Auth.js session secret (any long random string, e.g. `openssl rand -hex 32`).
# Empty = generated once in web/.data/.
AUTH_SECRET=

# Google login: OAuth client (Web) from https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
# tools/google_oauth_env.py can write these into web/.env.local.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Stripe TEST mode secret key (sk_test_...) from the Dashboard → Developers → API keys
STRIPE_SECRET_KEY=

# Webhook signing secret (whsec_...): `stripe listen --forward-to localhost:3000/api/saas/webhook`
STRIPE_WEBHOOK_SECRET=

# Public URL for OAuth and Stripe redirects when not localhost
APP_URL=
