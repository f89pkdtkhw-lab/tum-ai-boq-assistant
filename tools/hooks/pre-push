#!/bin/sh
# Push check for everyone on the team and all coding agents.
# Enabled by: python tools/setup.py
# Skip only in an emergency: git push --no-verify

# Prevent direct pushes to shared branches; changes arrive only through pull requests.
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/demo)
      echo "✗ No direct push to ${remote_ref#refs/heads/}. Push your own branch and open a pull request." >&2
      exit 1
      ;;
  esac
done

# Graphify is mandatory for agents; offline tests work without installation.
if ! command -v graphify >/dev/null 2>&1; then
  echo "! Graphify missing: run python tools/setup.py; update the code graph before the next task." >&2
fi

# Find the first Python 3.11+. On Windows python3 may be a Store placeholder.
PY=""
for candidate in python3 python py; do
  if command -v "$candidate" >/dev/null 2>&1 &&
     "$candidate" -c "import sys; sys.exit(sys.version_info < (3, 11))" >/dev/null 2>&1; then
    PY="$candidate"
    break
  fi
done
if [ -z "$PY" ]; then
  echo "✗ Push check: no Python 3.11 or newer found." >&2
  exit 1
fi

cd "$(git rev-parse --show-toplevel)" || exit 1
if ! "$PY" -m unittest discover -s tests -q; then
  echo "✗ Tests failed, push aborted. Fix the errors above and push again." >&2
  exit 1
fi
