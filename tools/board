#!/bin/sh
# Shortcut for macOS, Linux and Git Bash: tools/board <post|unread|read|wait|whoami>
# Find the first Python 3.8+ and start tools/board.py.
for candidate in python3 python py; do
  if command -v "$candidate" >/dev/null 2>&1 &&
     "$candidate" -c "import sys; sys.exit(sys.version_info < (3, 8))" >/dev/null 2>&1; then
    exec "$candidate" "$(dirname "$0")/board.py" "$@"
  fi
done
echo "board: no Python 3.8 or newer found" >&2
exit 1
